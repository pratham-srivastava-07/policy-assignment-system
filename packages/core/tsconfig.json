{
  "compilerOptions": {
    "target": "es2016",
    // Declared explicitly rather than inherited from `target`: this package
    // uses Object.values (ES2017) and Array.prototype.flatMap (ES2019).
    // Relying on @types/node to widen the lib as a side effect makes the build
    // fragile to a dependency bump.
    "lib": ["ES2020"],
    "module": "commonjs",
    "moduleResolution": "node",
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
