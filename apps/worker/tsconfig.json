{
  "compilerOptions": {
    "target": "es2016",
    // Declared explicitly for the same reason the other packages declare it:
    // this code uses Object.values (ES2017), and letting @types/node widen the
    // lib as a side effect makes the build depend on a dependency's internals.
    "lib": ["ES2020"],
    "module": "commonjs",
    "moduleResolution": "node",
    "rootDir": "./src",
    "outDir": "./dist",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
