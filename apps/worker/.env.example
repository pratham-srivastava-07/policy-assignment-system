# The worker reads the same database as the API.
DATABASE_URL="postgresql://user:password@localhost:5432/mydb?schema=public"

# BullMQ's backing store. Matches the redis service in infra/docker-compose.yml.
REDIS_URL="redis://localhost:6380"

NODE_ENV=development

# --- Outbox relay tuning. Every value has a working default; these are the
# --- knobs an operator reaches for when one worker stops being enough.
# How often the relay polls for PENDING rows.
OUTBOX_POLL_INTERVAL_MS=1000
# Rows claimed per poll.
OUTBOX_BATCH_SIZE=50
# Enqueue attempts before a row is left terminally FAILED.
OUTBOX_MAX_ATTEMPTS=5
# Exponential backoff between enqueue attempts.
OUTBOX_BACKOFF_BASE_MS=1000
OUTBOX_BACKOFF_MAX_MS=3600000
# How long a claimed row stays leased before another relay may reclaim it.
OUTBOX_CLAIM_LEASE_MS=60000

# --- Job processing.
RECONCILIATION_CONCURRENCY=5
RECONCILIATION_JOB_ATTEMPTS=3
